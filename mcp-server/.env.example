MCP_HOST=127.0.0.1
MCP_PORT=3001
# Use a strong random string for JWT signing/verification.
# Note: In production, do NOT share this key.
MCP_JWT_SECRET=

# Preferred: use an SAP destination configured in sapnwrfc.ini
SAP_DEST=

# Fallback: direct connection parameters if you do not use SAP_DEST
SAP_ASHOST=
SAP_SYSNR=
SAP_CLIENT=
SAP_USER=
SAP_PASSWD=
SAP_LANG=EN

SAP_POOL_LOW=0
SAP_POOL_HIGH=4
SAP_RFC_TIMEOUT_MS=30000

# Preferred S/4-compatible table-reader FM order.
# Add a custom Z reader at the front if your system uses one.
SAP_TABLE_READ_FUNCTIONS=/BUI/RFC_READ_TABLE,BBP_RFC_READ_TABLE

# Optional: add extra tables beyond the built-in Hypercare baseline allowlist.
SAP_ALLOWED_TABLES=

# Optional: add extra read-only RFCs or custom ZHC_* wrappers beyond the built-in baseline allowlist.
SAP_ALLOWED_FUNCTIONS=
